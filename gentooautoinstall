#!/bin/bash
set -e

echo "=== Доустановка Gentoo (Stage3 уже есть) ==="

# Запрос пароля
read -sp "Введите пароль для root: " ROOT_PASSWORD
echo ""

# 1. Монтирование (если еще не смонтировано)
if ! mountpoint -q /mnt/gentoo; then
    echo "Монтирование разделов..."
    mount /dev/sdb3 /mnt/gentoo
    mount /dev/sdb1 /mnt/gentoo/efi
fi

# 2. Настройка make.conf (перезаписываем на всякий случай)
echo "Настройка make.conf..."
cat << MAKE_CONF > /mnt/gentoo/etc/portage/make.conf
COMMON_FLAGS="-O2 -pipe -march=native"
CFLAGS="\${COMMON_FLAGS}"
CXXFLAGS="\${COMMON_FLAGS}"
FCFLAGS="\${COMMON_FLAGS}"
FFLAGS="\${COMMON_FLAGS}"
MAKEOPTS="-j\$(nproc)"
PORTAGE_NICENESS=19
EMERGE_DEFAULT_OPTS="--jobs=\$(nproc) --load-average=\$(nproc)"
ACCEPT_LICENSE="*"
GRUB_PLATFORMS="efi-64"
USE="elogind unicode nls -systemd"
MAKE_CONF

mkdir -p /mnt/gentoo/etc/portage/repos.conf
cp /mnt/gentoo/usr/share/portage/config/repos.conf /mnt/gentoo/etc/portage/repos.conf/gentoo.conf

# 3. Служебные монтирования для chroot
cp --dereference /etc/resolv.conf /mnt/gentoo/etc/
mount --types proc /proc /mnt/gentoo/proc
mount --rbind /sys /mnt/gentoo/sys
mount --make-rslave /mnt/gentoo/sys
mount --rbind /dev /mnt/gentoo/dev
mount --make-rslave /mnt/gentoo/dev
mount --bind /run /mnt/gentoo/run
mount --make-slave /mnt/gentoo/run

# 4. Скрипт настройки внутри системы
cat << 'CHROOT_BODY' > /mnt/gentoo/chroot_script.sh
#!/bin/bash
set -e
source /etc/profile

echo "Синхронизация..."
emerge-webrsync -q

echo "Europe/Moscow" > /etc/timezone
emerge --config sys-libs/timezone-data
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo 'LANG="en_US.UTF-8"' > /etc/locale.conf
env-update && source /etc/profile

echo "gentoo-pc" > /etc/hostname

# Проверка fstab (если уже есть, не трогаем)
if [ ! -f /etc/fstab ]; then
    BOOT_UUID=$(blkid -s UUID -o value /dev/sdb1)
    SWAP_UUID=$(blkid -s UUID -o value /dev/sdb2)
    ROOT_UUID=$(blkid -s UUID -o value /dev/sdb3)
    cat << FSTAB > /etc/fstab
UUID=$BOOT_UUID	/efi	vfat	defaults,noatime	0 2
UUID=$SWAP_UUID	none	swap	sw			0 0
UUID=$ROOT_UUID	/	ext4	noatime			0 1
FSTAB
fi

echo "Установка ядра и загрузчика..."
emerge --usepkg y sys-kernel/gentoo-kernel-bin sys-kernel/linux-firmware sys-boot/grub sys-apps/dbus sys-process/elogind net-misc/dhcpcd

rc-update add dbus default
rc-update add elogind default
rc-update add dhcpcd default || true

grub-install --target=x86_64-efi --efi-directory=/efi --bootloader-id=Gentoo
grub-mkconfig -o /boot/grub/grub.cfg

echo "root:$ROOT_PASSWORD" | chpasswd
CHROOT_BODY

# Запуск
sed -i "s/\$ROOT_PASSWORD/$ROOT_PASSWORD/g" /mnt/gentoo/chroot_script.sh
chmod +x /mnt/gentoo/chroot_script.sh
chroot /mnt/gentoo /chroot_script.sh
rm /mnt/gentoo/chroot_script.sh

umount -l /mnt/gentoo/dev{/shm,/pts,}
umount -R /mnt/gentoo
echo "Готово!"
